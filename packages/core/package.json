{
  "name": "calculadora-rtc-core",
  "version": "0.4.4",
  "description": "Motor de cálculo da Reforma Tributária (CBS, IBS e Imposto Seletivo — LC 214/2025). Porte TS da API oficial da Receita Federal, com banco de dados embutido e CLI. Paridade verificada por golden tests.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node scripts/prepack-db.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "decimal.js": "^10.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "reforma-tributaria",
    "cbs",
    "ibs",
    "imposto-seletivo",
    "receita-federal",
    "lc214",
    "tributos",
    "fiscal",
    "nf-e",
    "sefaz"
  ],
  "bin": {
    "calculadora-rtc": "dist/cli.js"
  },
  "files": [
    "dist",
    "db",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Filip3Dev/calculadora-rtc-regime-regular-ts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Filip3Dev/calculadora-rtc-regime-regular-ts#readme",
  "bugs": {
    "url": "https://github.com/Filip3Dev/calculadora-rtc-regime-regular-ts/issues"
  },
  "author": "Filip3Dev",
  "engines": {
    "node": ">=22"
  }
}
