{
  // Worker de borda da Calculadora RTC: publica o playground como Static
  // Assets e proxya /api/* para o container (Dockerfile da raiz do monorepo).
  "name": "calculadora-rtc",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],

  // Domínio próprio (cria o registro DNS + certificado no deploy).
  "routes": [{ "pattern": "rtc.bitpag.xyz", "custom_domain": true }],

  // run_worker_first: navegações a /api/* (ex.: /api/swagger) precisam chegar
  // ao Worker ANTES do fallback SPA — sem isso, o Static Assets serve o
  // index.html do playground para qualquer documento que não casa com asset.
  // Demais caminhos seguem servindo assets + fallback SPA normalmente.
  "assets": {
    "directory": "../../apps/playground/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "containers": [
    {
      "class_name": "CalculadoraContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "../../Dockerfile" }
      }
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "CONTAINER", "class_name": "CalculadoraContainer" }]
  },

  "exports": {
    "CalculadoraContainer": { "type": "durable-object", "storage": "sqlite" }
  },

  "observability": { "enabled": true }
}
